# DSDA-Doom for AmigaOS 3.x / AmiCradle, 68040 + FPU, on OpenGPU's SDL 2.
# Software renderer only.
#
#   make -f amiga/Makefile.amigaos STOVE=/path/to/os32-gcc16/prefix \
#        NDK=/path/to/gfopensdk/OpenNDK/Include_H \
#        SDL2KIT=/path/to/opengpu-sdk ZLIB=/path/to/zlib-1.3.1
#
# STOVE is GFOpenAmigaGCC 16.2.0-open4 or later (C and C++: DSDA's
# UMAPINFO and its scanner are C++). SDL2KIT is the OpenGPU developer kit
# (include/SDL2, lib/libSDL2.a and lib/libSDL2_mixer.a, the program's halves
# of LIBS:OpenGPU/SDL2.module and SDL2_mixer.module), as in the Chocolate
# and Crispy Doom ports. ZLIB's inflate is built in for compressed ZDBSP
# nodes. HOSTCC builds rdatawad, upstream's tool that makes dsda-doom.wad
# (the engine's own resource WAD, GPL, from prboom2/data).
# Output: build/amigaos/DSDADoom/ with the program, dsda-doom.wad, the
# ReadMe, the GPL and the icons. No IWAD is built in or packaged: see
# amiga/IWAD-ReadMe.

STOVE   ?= $(HOME)/AmiCradle/stoves/os32-gcc16/prefix
NDK     ?= $(HOME)/AmiCradle/gfopensdk/OpenNDK/Include_H
SDL2KIT ?= ../../deps/opengpu-sdk
ZLIB    ?= ../zlib-1.3.1
HOSTCC  ?= cc
PYTHON  ?= python3
CC      = $(STOVE)/bin/m68k-amigaos-gcc
CXX     = $(STOVE)/bin/m68k-amigaos-g++
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too). No -ffast-math (upstream's CMake
# has it): with -m68881 it makes GCC use fsin, fcos, fatan and the like,
# which a 68040 or 68060 does not have and emulates slowly in software.
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns
SRCDIR  = prboom2/src
DEFS    = -DHAVE_CONFIG_H
INC     = -Iamiga -I$(SRCDIR) -I$(SDL2KIT)/include/SDL2 -I$(NDK) -I$(ZLIB)
# Upstream's own warning set (prboom2/CMakeLists.txt): -Wall less what it
# turns off (-Wno-unused, -Wno-switch, -Wno-sign-compare, -Wno-pointer-sign,
# -Wno-missing-field-initializers), the same for the C++ files. Beyond
# upstream's, each checked:
# -Wno-char-subscripts: upstream passes plain (signed) char to <ctype.h>'s
#   macros in DEH, config and command-line parsing; libnix's newlib-style
#   macros warn about that on purpose; harmless for the ASCII text read.
# -Wno-misleading-indentation: r_drawcolumn.inl's one-line if/else layout.
# -Wno-format-overflow -Wno-format-truncation: GCC's guesses at upstream's
#   fixed text buffers (HUD and intermission strings, map and lump names,
#   snprintf that truncates on purpose). The one that could overflow, the
#   GL_ node lump name in p_setup.c, is fixed; the HUD's kill/secret lines
#   only grow long in a netgame, which this build doesn't have.
# -Wno-class-memaccess (C++): Scanner::SaveState copies a Scanner (plain
#   data and two pointers, which it then re-duplicates) with memcpy.
WARN    = -Wall -Wno-missing-field-initializers -Wno-unused -Wno-switch \
          -Wno-sign-compare -Wno-pointer-sign -Wno-char-subscripts \
          -Wno-misleading-indentation -Wno-format-overflow -Wno-format-truncation
CFLAGS  = -noixemul -std=gnu99 $(OPT) $(CPU) $(WARN) $(DEFS) $(INC)
CXXFLAGS = -noixemul -std=gnu++11 $(OPT) $(CPU) \
          $(filter-out -Wno-pointer-sign,$(WARN)) -Wno-class-memaccess \
          -fno-exceptions -fno-rtti $(DEFS) $(INC)
ZFLAGS  = -noixemul -O2 $(CPU) -I$(ZLIB) -include unistd.h
LDFLAGS = -noixemul $(CPU)
LIBS    = -L$(SDL2KIT)/lib -lSDL2_mixer -lSDL2 -lm
BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
OUT     = $(BUILD)/DSDADoom
PROG    = dsda-doom
WAD     = dsda-doom.wad

# As prboom2/src/CMakeLists.txt builds dsda-doom without OpenGL: every
# file but the GL renderer (gl_*.c), the Windows-only launcher, opendir
# and main, the window icon (unused by the SDL 2 code) and w_mmap.c (no
# mmap: w_memcache.c reads lumps instead).
SRC_C   = $(filter-out $(SRCDIR)/gl_% $(SRCDIR)/e6y_launcher.c \
            $(SRCDIR)/win_opendir.c $(SRCDIR)/icon.c $(SRCDIR)/w_mmap.c \
            $(SRCDIR)/SDL/SDL_windows_main.c, \
            $(wildcard $(SRCDIR)/*.c $(SRCDIR)/dsda/*.c $(SRCDIR)/dsda/*/*.c \
              $(SRCDIR)/heretic/*.c $(SRCDIR)/hexen/*.c $(SRCDIR)/SDL/*.c \
              $(SRCDIR)/MUSIC/*.c $(SRCDIR)/PCSOUND/*.c $(SRCDIR)/TEXTSCREEN/*.c))
SRC_CXX = $(wildcard $(SRCDIR)/*.cpp $(SRCDIR)/dsda/*.cpp)
OBJS    = $(SRC_C:%.c=$(OBJDIR)/%.o) $(SRC_CXX:%.cpp=$(OBJDIR)/%.o) \
          $(OBJDIR)/amiga/pthread_stubs.o
ZSRC    = adler32 crc32 inffast inflate inftrees zutil
ZOBJS   = $(ZSRC:%=$(OBJDIR)/zlib/%.o)

# rdatawad, for the build machine, and the WAD it makes.
RDDIR   = prboom2/data
RDSRC   = rd_main rd_util rd_output rd_sound rd_palette rd_graphic
RDATAWAD = $(BUILD)/host/rdatawad

# Per file, where the warning is about a type that is the same size here:
# %i and %ld given a size_t or unsigned int (all 32 bits on the 68k);
# gameskill declared int in text_file.c and skill_t elsewhere (enums are
# 32 bits); input.c declares an array parameter as a pointer.
$(OBJDIR)/prboom2/src/dsda/split_tracker.o \
$(OBJDIR)/prboom2/src/MUSIC/oplplayer.o \
$(OBJDIR)/prboom2/src/MUSIC/midifile.o: WARN += -Wno-format
$(OBJDIR)/prboom2/src/dsda/text_file.o: WARN += -Wno-enum-int-mismatch
$(OBJDIR)/prboom2/src/dsda/input.o: WARN += -Wno-array-parameter

ICONS   = amiga/icons/DSDADoom.info amiga/icons/$(PROG).info \
          amiga/icons/ReadMe.info amiga/icons/COPYING.txt.info \
          amiga/icons/IWAD-ReadMe.info

.DEFAULT_GOAL := all

all: $(OUT)/$(PROG)

$(OUT)/$(PROG): $(OBJS) $(ZOBJS) $(OUT)/$(WAD) $(ICONS) AMIGA_PORT.md amiga/IWAD-ReadMe | $(OUT)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(ZOBJS) $(LIBS)
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp prboom2/COPYING $(OUT)/COPYING.txt
	cp amiga/IWAD-ReadMe $(OUT)/IWAD-ReadMe
	cp amiga/icons/$(PROG).info amiga/icons/ReadMe.info \
	   amiga/icons/COPYING.txt.info amiga/icons/IWAD-ReadMe.info $(OUT)/
	cp amiga/icons/DSDADoom.info $(BUILD)/DSDADoom.info

$(OBJDIR)/%.o: %.c amiga/config.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJDIR)/%.o: %.cpp amiga/config.h
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# pthread_stubs.c: libstdc++ and libgcc's unwinder ask for POSIX threads;
# the C++ parts run on one task. Its loose signatures are not checked
# against a header.
$(OBJDIR)/amiga/pthread_stubs.o: amiga/pthread_stubs.c
	@mkdir -p $(dir $@)
	$(CC) -noixemul -O2 $(CPU) -c -o $@ $<

$(OBJDIR)/zlib/%.o: $(ZLIB)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(ZFLAGS) -c -o $@ $<

$(RDATAWAD): $(RDSRC:%=$(RDDIR)/%.c) amiga/host/config.h
	@mkdir -p $(dir $@)
	$(HOSTCC) -O2 -Iamiga/host -o $@ $(RDSRC:%=$(RDDIR)/%.c)

$(OUT)/$(WAD): $(RDATAWAD) $(RDDIR)/CMakeLists.txt amiga/wadargs.py | $(OUT)
	$(RDATAWAD) -I $(RDDIR) $$($(PYTHON) amiga/wadargs.py $(RDDIR)/CMakeLists.txt) -o $@

# The objects alone, without linking or packaging.
objs: $(OBJS) $(ZOBJS)

wad: $(OUT)/$(WAD)

$(OUT):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all objs wad clean
